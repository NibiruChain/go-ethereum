# .cursorignore
#
# ## .cursorignore Syntax Exmaple
# It's generally close to .gitignore syntax with. Examples:
# config.json     # Specific file
# dist/           # Directory
# *.log           # File extension
# **/logs         # Nested directories
# !app/           # Exclude from ignore (negate) 
#
# -----------------------------------------------------------------

# Include (!, exclude from ignroe) all patterns from .gitignore
!.gitignore

# Additional patterns specific to Cursor
.env*
**/credentials/*
**/secrets/*
private/
confidential/

# Large binary files and datasets
*.bin
*.dat
*.db
*.sqlite
*.sqlite3

# Exclude large generated files
node_modules/
dist/
.cache/ 

# -----------------------------------------------------------------
# Custom nibi-geth
# -----------------------------------------------------------------

# Remove the fuzz
*fuzz*
fuzzing
fuzzers

